{
  "name": "clip-drop",
  "version": "0.1.1",
  "private": true,
  "description": "CLIP Drop Windows download and guide",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --test tests/public-build.test.mjs",
    "build": "node scripts/build-public.mjs",
    "postbuild": "node scripts/web-security.mjs --verify-dist",
    "release:preflight": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\release_app_preflight.ps1 -App clip-drop",
    "predeploy": "npm run release:preflight && npm run build",
    "deploy": "node scripts/deploy-pages.mjs"
  }
}
